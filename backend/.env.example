# Copy to .env and fill in. Docker Compose overrides the hosts for its own network.
HEATMARK_DATABASE_URL=postgresql+asyncpg://heatmark:heatmark@localhost:5433/heatmark
HEATMARK_REDIS_URL=redis://localhost:6380/0
# Uploads go to Google Cloud Storage. Auth: `gcloud auth application-default login`.
HEATMARK_STORAGE_BACKEND=gcs
HEATMARK_DOCUMENTS_BUCKET=heatmark-documents
HEATMARK_GCP_PROJECT=
HEATMARK_GCS_CREDENTIALS_FILE=
# HEATMARK_STORAGE_BACKEND=local   # offline: files under HEATMARK_STORAGE_DIR
# HEATMARK_STORAGE_DIR=./var/storage
HEATMARK_CORS_ORIGINS=["http://localhost:5173"]

# Read by the google-genai SDK directly. Free-tier keys: Google may use the data to improve
# its products, so use sample documents only; use a paid key for real customer files.
GEMINI_API_KEY=

# Development uses gemini-3.8-flash for everything. For production accuracy:
# HEATMARK_EXTRACT_MODEL=gemini-4-argon
# HEATMARK_EXTRACT_THINKING=HIGH

# JWT sign-in. Required. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
HEATMARK_JWT_SECRET=
# HEATMARK_JWT_TTL_HOURS=12
# Demo account used by the login page's "Try the demo" button (created by: python -m app.demo)
# HEATMARK_DEMO_EMAIL=demo@heatmark.app
# HEATMARK_DEMO_PASSWORD=heatmark-demo

# Google sign-in (OAuth client from Google Cloud Console > APIs & Services > Credentials).
# The secret stays on the backend; the frontend only gets the client ID (VITE_GOOGLE_CLIENT_ID).
HEATMARK_GOOGLE_CLIENT_ID=
HEATMARK_GOOGLE_CLIENT_SECRET=
# Only these email domains may sign in with Google (new accounts are created on first sign-in). Empty = any Google account.
# HEATMARK_GOOGLE_ALLOWED_DOMAINS=["company.com"]
